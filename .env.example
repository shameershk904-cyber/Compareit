# -----------------------------------------------------------------------------
# CompareIt.pk - Environment Configuration Template
# -----------------------------------------------------------------------------

# PostgreSQL Database (Supabase)
# DATABASE_URL: Pooled connection string (pgbouncer port 6543) for Next.js App Router
DATABASE_URL=postgresql://postgres.cevetoazfcbjmodmjzyh:CmprIt%402026%23@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&pool_timeout=30&connect_timeout=30

# DIRECT_URL: Direct database connection (port 5432) for Prisma migrations
DIRECT_URL=postgresql://postgres.cevetoazfcbjmodmjzyh:CmprIt%402026%23@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require

# NextAuth / Auth.js Secret (generate via `npx auth secret` or `openssl rand -base64 32`)
AUTH_SECRET="your-32-byte-secret-key-here"

# Supabase Storage & API Keys
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Contact Form Inquiries & Real-time Alerts
# 1. Instant Webhook Alerts (Discord or Slack channel)
# Paste a Discord webhook URL or Slack incoming webhook URL:
CONTACT_WEBHOOK_URL="https://discord.com/api/webhooks/your-webhook-id/your-webhook-token"

# 2. Email Delivery via Resend (Optional)
RESEND_API_KEY=""
CONTACT_NOTIFICATION_EMAIL="hello@compareit.pk"
RESEND_FROM_EMAIL="CompareIt.pk <onboarding@resend.dev>"
